#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/common.sh"
require_service_account

TMP_DIRS=()
cleanup_tmp_dirs() {
  local directory
  for directory in "${TMP_DIRS[@]}"; do
    [[ -d "$directory" ]] || continue
    rm -f "$directory"/*
    rmdir "$directory"
  done
}
trap cleanup_tmp_dirs EXIT

usage() {
  echo "usage: seaweed {preflight|bootstrap-buckets|copy-f1-completed|verify-f1-completed|copy-f1-final|verify-f1-final|verify-f1-existing|status|smoke-f1|smoke-f2|test-s3-endpoint|smoke-multipart-f1|smoke-multipart-f2}" >&2
  exit 2
}

preflight() {
  need curl; need jq; need python3; need podman; need rclone
  local rclone_version
  rclone_version="$(rclone version | awk 'NR == 1 {sub(/^rclone v/, ""); sub(/-.*/, ""); print}')"
  [[ "$(printf '%s\n%s\n' 1.75.1 "$rclone_version" | sort -V | head -1)" == 1.75.1 ]] || {
    echo "ERROR: rclone >= 1.75.1 required; found $rclone_version" >&2
    exit 2
  }
  [[ -d "$SOURCE_ROOT" ]] || { echo "ERROR: missing source: $SOURCE_ROOT" >&2; exit 1; }
  "$SCRIPT_DIR/migration.py" inspect --source "$SOURCE_ROOT" \
    --mlflow-url "${MLFLOW_F1_URL:-http://127.0.0.1:5001/mlflow-f1}"
  local source_bytes source_files available required
  source_bytes="$(du -sb "$SOURCE_ROOT" | awk '{print $1}')"
  source_files="$(find "$SOURCE_ROOT" -type f -printf . | wc -c)"
  available="$(df -B1 --output=avail "$DATA_ROOT" | tail -1 | tr -d ' ')"
  required=$((source_bytes * 3 / 2 + 50000000000))
  (( available >= required )) || { echo "ERROR: need >= $required free bytes; have $available" >&2; exit 1; }
  curl -fsS "${MLFLOW_F1_URL:-http://127.0.0.1:5001/mlflow-f1}/health" >/dev/null
  echo "OK account=svc-infra rclone=$rclone_version source_bytes=$source_bytes source_files=$source_files available_bytes=$available"
}

bootstrap_buckets() {
  need podman; need rclone
  local tmp
  tmp="$(mktemp -d)"; TMP_DIRS+=("$tmp")
  local iam_json identity configured_access configured_secret
  iam_json="$(secret_value seaweed_s3_config)"
  while read -r identity access secret; do
    configured_access="$(jq -er --arg name "$identity" '.identities[] | select(.name == $name) | .credentials[0].accessKey' <<<"$iam_json")"
    configured_secret="$(jq -er --arg name "$identity" '.identities[] | select(.name == $name) | .credentials[0].secretKey' <<<"$iam_json")"
    [[ "$configured_access" == "$(secret_value "$access")" && "$configured_secret" == "$(secret_value "$secret")" ]] || {
      echo "ERROR: $identity credentials differ between seaweed_s3_config and service secrets" >&2
      exit 1
    }
  done <<'EOF'
bootstrap-admin seaweed_s3_admin_access_key seaweed_s3_admin_secret_key
mlflow-f1 mlflow_f1_s3_access_key mlflow_f1_s3_secret_key
mlflow-f2 mlflow_f2_s3_access_key mlflow_f2_s3_secret_key
f2-corpus f2_corpus_s3_access_key f2_corpus_s3_secret_key
EOF
  unset iam_json configured_access configured_secret
  make_rclone_config seaweed_s3_admin_access_key seaweed_s3_admin_secret_key "$tmp/admin.conf" false
  for bucket in mlflow-f1-artifacts mlflow-f2-artifacts f2-corpus; do
    rclone mkdir "seaweed:$bucket" --config "$tmp/admin.conf"
  done
  local name access secret allowed candidate config sentinel_hash downloaded_hash
  printf 'SeaweedFS bootstrap credential test\n' >"$tmp/sentinel"
  sentinel_hash="$(sha256sum "$tmp/sentinel" | awk '{print $1}')"
  while read -r name access secret allowed; do
    config="$tmp/$name.conf"; make_rclone_config "$access" "$secret" "$config"
    rclone lsf "seaweed:$allowed" --config "$config" >/dev/null
    if rclone cat "seaweed:$allowed/_infra/bootstrap-sentinel" --config "$config" >"$tmp/$name.download" 2>/dev/null; then
      downloaded_hash="$(sha256sum "$tmp/$name.download" | awk '{print $1}')"
      [[ "$sentinel_hash" == "$downloaded_hash" ]] || {
        echo "ERROR: existing $name bootstrap sentinel has different content" >&2; exit 1;
      }
    else
      rclone copyto "$tmp/sentinel" "seaweed:$allowed/_infra/bootstrap-sentinel" --config "$config" --immutable
      downloaded_hash="$(rclone cat "seaweed:$allowed/_infra/bootstrap-sentinel" --config "$config" | sha256sum | awk '{print $1}')"
    fi
    [[ "$sentinel_hash" == "$downloaded_hash" ]] || { echo "ERROR: $name put/get checksum mismatch" >&2; exit 1; }
    for candidate in mlflow-f1-artifacts mlflow-f2-artifacts f2-corpus; do
      [[ "$candidate" == "$allowed" ]] && continue
      if rclone lsf "seaweed:$candidate" --config "$config" >/dev/null 2>&1; then
        echo "ERROR: $name credential can access forbidden bucket $candidate" >&2; exit 1
      fi
    done
  done <<'EOF'
f1 mlflow_f1_s3_access_key mlflow_f1_s3_secret_key mlflow-f1-artifacts
f2 mlflow_f2_s3_access_key mlflow_f2_s3_secret_key mlflow-f2-artifacts
corpus f2_corpus_s3_access_key f2_corpus_s3_secret_key f2-corpus
EOF
  echo 'OK buckets exist and sampled cross-bucket access was denied'
}

latest_report() {
  local mode=$1
  local pointer="$REPORT_ROOT/latest-$mode"
  [[ -f "$pointer" ]] || { echo "ERROR: no copy report for $mode" >&2; exit 1; }
  local dir; dir="$(<"$pointer")"
  [[ -d "$dir" ]] || { echo "ERROR: report missing: $dir" >&2; exit 1; }
  printf '%s\n' "$dir"
}

copy_f1() {
  local mode=$1 report tmp
  need python3; need podman; need rclone
  report="$(new_report_dir "$mode")"; tmp="$(mktemp -d)"; TMP_DIRS+=("$tmp")
  "$SCRIPT_DIR/migration.py" prepare --source "$SOURCE_ROOT" --report "$report" \
    --mlflow-url "${MLFLOW_F1_URL:-http://127.0.0.1:5001/mlflow-f1}" --mode "$mode" | tee "$report/prepare.log"
  if [[ "$mode" == final ]]; then
    mv "$report/sha256.txt" "$report/sha256.first.txt"
    mv "$report/paths.txt" "$report/paths.first.txt"
    mv "$report/runs.json" "$report/runs.first.json"
    mv "$report/summary.json" "$report/summary.first.json"
    mv "$report/prepare.log" "$report/prepare.first.log"
    "$SCRIPT_DIR/migration.py" prepare --source "$SOURCE_ROOT" --report "$report" \
      --mlflow-url "${MLFLOW_F1_URL:-http://127.0.0.1:5001/mlflow-f1}" --mode "$mode" | tee "$report/prepare.log"
    for name in sha256.txt paths.txt runs.json summary.json; do
      first="${name%.*}.first.${name##*.}"
      if ! cmp -s "$report/$first" "$report/$name"; then
        echo "ERROR: F1 changed between final manifests ($name); stop writers and retry; report=$report" >&2
        exit 1
      fi
    done
    echo 'OK two consecutive F1 manifests match'
  fi
  make_rclone_config mlflow_f1_s3_access_key mlflow_f1_s3_secret_key "$tmp/rclone.conf"
  rclone copy "$SOURCE_ROOT" seaweed:mlflow-f1-artifacts --config "$tmp/rclone.conf" \
    --files-from-raw "$report/paths.txt" --immutable --bwlimit 25Mi --transfers 2 --checkers 2 \
    --log-file "$report/rclone-copy.log" --log-level INFO
  printf '%s\n' "$report" >"$REPORT_ROOT/latest-$mode"
  echo "OK copied without deletion; report=$report"
}

verify_f1() {
  local mode=$1 report tmp expected_count expected_bytes actual_count actual_bytes
  need jq; need podman; need rclone
  report="$(latest_report "$mode")"; tmp="$(mktemp -d)"; TMP_DIRS+=("$tmp")
  make_rclone_config mlflow_f1_s3_access_key mlflow_f1_s3_secret_key "$tmp/rclone.conf"
  if ! rclone checksum SHA-256 "$report/sha256.txt" seaweed:mlflow-f1-artifacts \
      --config "$tmp/rclone.conf" --download --checkers 2 \
      --files-from-raw "$report/paths.txt" \
      --log-file "$report/rclone-verify.log" --log-level INFO; then
    echo "ERROR: checksum verification failed; report=$report" >&2; exit 1
  fi
  expected_count="$(jq -r .files "$report/summary.json")"
  expected_bytes="$(jq -r .bytes "$report/summary.json")"
  rclone size seaweed:mlflow-f1-artifacts --config "$tmp/rclone.conf" --json \
    --files-from-raw "$report/paths.txt" >"$report/target-size.json"
  actual_count="$(jq -r .count "$report/target-size.json")"
  actual_bytes="$(jq -r .bytes "$report/target-size.json")"
  [[ "$expected_count" == "$actual_count" && "$expected_bytes" == "$actual_bytes" ]] || {
    echo "ERROR: size mismatch expected=$expected_count/$expected_bytes actual=$actual_count/$actual_bytes" >&2; exit 1;
  }
  jq -e '.excluded_running | type == "array"' "$report/runs.json" >/dev/null
  echo "OK sha256/count/bytes match; files=$actual_count bytes=$actual_bytes report=$report"
}

status() {
  need curl; need podman
  for url in http://127.0.0.1:9000/healthz http://127.0.0.1:5001/mlflow-f1/health http://127.0.0.1:5002/mlflow-f2/health; do
    if curl -fsS --max-time 3 "$url" >/dev/null; then echo "UP $url"; else echo "DOWN $url"; fi
  done
  podman ps --filter 'name=seaweed-' --format '{{.Names}} {{.Status}}'
  if command -v rclone >/dev/null && podman secret exists seaweed_s3_admin_access_key; then
    local tmp; tmp="$(mktemp -d)"; TMP_DIRS+=("$tmp")
    make_rclone_config seaweed_s3_admin_access_key seaweed_s3_admin_secret_key "$tmp/rclone.conf"
    rclone lsd seaweed: --config "$tmp/rclone.conf"
  fi
}

smoke_mlflow() {
  local instance=$1
  need podman
  podman exec -i -e "MLFLOW_TRACKING_URI=http://127.0.0.1:5000/mlflow-$instance" "mlflow_$instance" \
    python - <"$SCRIPT_DIR/smoke_f2.py"
}

verify_f1_existing() {
  local report selection run_id artifact_path expected
  need jq; need podman; need python3
  report="$(latest_report final)"
  selection="$(python3 - "$report" <<'PY'
import json
import sys
from pathlib import Path

report = Path(sys.argv[1])
selected = {(str(item[0]), str(item[1])) for item in json.loads((report / "runs.json").read_text())["selected"]}
for line in (report / "sha256.txt").read_text().splitlines():
    digest, separator, relative = line.partition("  ")
    parts = relative.split("/")
    if separator and len(parts) >= 4 and (parts[0], parts[1]) in selected and parts[2] == "artifacts":
        print(json.dumps({"run_id": parts[1], "artifact_path": "/".join(parts[3:]), "sha256": digest}))
        break
else:
    raise SystemExit("ERROR: no existing active run artifact found in final manifest")
PY
)"
  run_id="$(jq -r .run_id <<<"$selection")"
  artifact_path="$(jq -r .artifact_path <<<"$selection")"
  expected="$(jq -r .sha256 <<<"$selection")"
  podman exec -i \
    -e MLFLOW_TRACKING_URI=http://127.0.0.1:5000/mlflow-f1 \
    -e "RUN_ID=$run_id" -e "ARTIFACT_PATH=$artifact_path" -e "EXPECTED_SHA256=$expected" \
    mlflow_f1 python - <"$SCRIPT_DIR/verify_existing.py"
}

smoke_multipart() {
  local instance=$1
  need podman
  podman exec -i -e "MLFLOW_TRACKING_URI=http://127.0.0.1:5000/mlflow-$instance" "mlflow_$instance" \
    python - <"$SCRIPT_DIR/smoke_multipart.py"
}

test_s3_endpoint() {
  local endpoint=${1:-https://esillileu-server.tail4941d3.ts.net:9000}
  need python3; need podman
  python3 "$SCRIPT_DIR/test_s3_compatibility.py" --endpoint "$endpoint"
}

case "${1:-}" in
  preflight) preflight ;;
  bootstrap-buckets) bootstrap_buckets ;;
  copy-f1-completed) copy_f1 completed ;;
  verify-f1-completed) verify_f1 completed ;;
  copy-f1-final) copy_f1 final ;;
  verify-f1-final) verify_f1 final ;;
  verify-f1-existing) verify_f1_existing ;;
  status) status ;;
  smoke-f1) smoke_mlflow f1 ;;
  smoke-f2) smoke_mlflow f2 ;;
  smoke-multipart-f1) smoke_multipart f1 ;;
  smoke-multipart-f2) smoke_multipart f2 ;;
  test-s3-endpoint) shift; test_s3_endpoint "$@" ;;
  *) usage ;;
esac
